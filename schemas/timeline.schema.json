{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://incubrix.example/schemas/timeline-1.0.0.json",
  "title": "IncuBrix Source-Anchored Timeline",
  "type": "object",
  "required": [
    "schema_version",
    "duration",
    "source_duration",
    "words",
    "captions",
    "segments",
    "effects",
    "music_tracks",
    "deliberate_pauses",
    "warnings"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "duration": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "source_duration": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "words": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/word"
      }
    },
    "captions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/caption"
      }
    },
    "segments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/segment"
      }
    },
    "effects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/effect"
      }
    },
    "music_tracks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/musicTrack"
      }
    },
    "deliberate_pauses": {
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "type": "number",
            "minimum": 0
          },
          {
            "type": "number",
            "exclusiveMinimum": 0
          }
        ],
        "minItems": 2,
        "maxItems": 2
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "word": {
      "type": "object",
      "required": [
        "id",
        "text",
        "start",
        "end",
        "speaker",
        "confidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "start": {
          "type": "number",
          "minimum": 0
        },
        "end": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "speaker": {
          "type": [
            "string",
            "null"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "caption": {
      "type": "object",
      "required": [
        "id",
        "text",
        "start_word_id",
        "end_word_id",
        "source_start",
        "source_end",
        "kind",
        "color",
        "font_size"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "start_word_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "end_word_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_start": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "source_end": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "kind": {
          "enum": [
            "caption",
            "text_overlay"
          ]
        },
        "color": {
          "type": "string",
          "minLength": 1
        },
        "font_size": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "segment": {
      "type": "object",
      "required": [
        "id",
        "source_start",
        "source_end",
        "speed"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source_start": {
          "type": "number",
          "minimum": 0
        },
        "source_end": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "speed": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": false
    },
    "effect": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "word_id",
        "frequency"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "mute",
            "bleep"
          ]
        },
        "word_id": {
          "type": "string",
          "minLength": 1
        },
        "frequency": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": false
    },
    "musicTrack": {
      "type": "object",
      "required": [
        "id",
        "source",
        "volume",
        "ducking"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "volume": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "ducking": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
