APP_NAME=IncuBrix Video Editing Engine
DATA_DIR=/data
DATABASE_PATH=/data/engine.sqlite3
OUTPUT_DIR=/data/outputs
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=incubrix-results
S3_REGION=us-east-1
S3_ACCESS_KEY=replace-with-local-minio-user
S3_SECRET_KEY=replace-with-local-minio-password
S3_PUBLIC_URL=
TRANSCRIBER=mock
WHISPER_MODEL=base
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
FFMPEG_FONT_FILE=
MAX_UPLOAD_BYTES=536870912
MAX_VIDEO_SECONDS=3600
MAX_URL_BYTES=536870912
DOWNLOAD_TIMEOUT_SECONDS=30
RATE_LIMIT_PER_MINUTE=120
JOB_WORKERS=2
CALLBACK_SECRET=
DEMO_ACCESS_TOKEN=
LOG_LEVEL=INFO
MINIO_ROOT_USER=replace-with-local-minio-user
MINIO_ROOT_PASSWORD=replace-with-local-minio-password
